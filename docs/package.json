{
  "name": "nola-translator-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run demo:build && vitepress dev .",
    "build": "npm run typecheck && npm run demo:build && vitepress build .",
    "demo:build": "node scripts/build-demo.mjs",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "preview": "vitepress preview .",
    "media": "node scripts/generate-screenshots.mjs"
  },
  "devDependencies": {
    "@giscus/vue": "^3.1.1",
    "busuanzi.pure.js": "^1.0.3",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-task-checkbox": "^1.0.6",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.17.2",
    "nprogress-v2": "^1.1.10",
    "vitepress": "1.6.4",
    "vitepress-markdown-timeline": "^1.2.2",
    "vitepress-plugin-group-icons": "^1.7.7",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-sidebar": "^1.40.0",
    "vue": "^3.5.22"
  }
}

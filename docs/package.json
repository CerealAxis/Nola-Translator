{
  "name": "nola-translator-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run demo:build && vitepress dev .",
    "build": "npm run typecheck && npm run demo:build && node --max-old-space-size=7168 ./node_modules/vitepress/bin/vitepress.js build .",
    "demo:build": "node scripts/build-demo.mjs",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "preview": "vitepress preview .",
    "media": "node scripts/generate-screenshots.mjs"
  },

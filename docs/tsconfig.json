{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@renderer/*": ["../src/renderer/*"],
      "@/*": ["../src/renderer/*"],
      "cn": ["../src/renderer/lib/utils.ts"]
    }
  },
  "include": ["media-src/**/*.ts", "media-src/**/*.tsx", ".vitepress/theme/**/*.tsx", ".vitepress/theme/content.ts", ".vitepress/theme/cookieConsent.ts", "../src/renderer/global.d.ts", "../src/renderer/vite-env.d.ts", "../browser/extension/chrome.d.ts"],
  "exclude": ["media-src/vis/demos/shadcn-base", "media-src/vis/shadcn-base"]
}

    "/api/v2/audio/preflight": {
      "post": {
        "summary": "Audio Preflight",
        "description": "Run routing.preflight_route against the real local topology so the\nsetup wizard can prove a route is loop-safe before a session starts.\n\nThe process-loopback capability probe activates COM off the event loop.\nVirtual input must resolve to a recording endpoint. Chromium playback\nIDs cannot identify the corresponding Windows endpoint.",
        "operationId": "audio_preflight_api_v2_audio_preflight_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AudioPreflightRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AudioPreflightRequest": {
        "properties": {
          "input_mode": {
            "type": "string",
            "title": "Input Mode"
          },
          "input_endpoint_id": {
            "type": "string",
            "title": "Input Endpoint Id",
            "default": ""
          },
          "excluded_process_tree": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Excluded Process Tree"
          },
          "speech_output_endpoint_id": {
            "type": "string",
            "title": "Speech Output Endpoint Id",
            "default": ""
          },
          "speech_output_endpoint_is_opaque": {
            "type": "boolean",
            "title": "Speech Output Endpoint Is Opaque",
            "default": false
          },
          "monitor_original": {
            "type": "boolean",
            "title": "Monitor Original",
            "default": false
          },
          "monitor_output_endpoint_id": {
            "type": "string",
            "title": "Monitor Output Endpoint Id",
            "default": ""
          },
          "probe_target_pid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probe Target Pid"
          },
          "process_selection_id": {
            "type": "string",
            "maxLength": 64,
            "title": "Process Selection Id",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "input_mode"
        ],
        "title": "AudioPreflightRequest",
        "description": "Route description the setup wizard submits for a safety preflight.\n\nMirrors routing.AudioRoute; kept as a private management model so the core\nsession contract in contracts.py is untouched. `excluded_process_tree` MUST\ncarry the real Electron playback tree (not just the backend PID) for\nprocess_exclude, or preflight reports missing_exclude_tree."
      },
      "AudioProcess": {
        "properties": {
          "pid": {
            "type": "integer",
            "title": "Pid"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          },
          "selection_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selection Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "pid",
          "name",
          "active",
          "selection_id",
          "reason"
        ],
        "title": "AudioProcess"
      },
      "AudioProcessesResponse": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "processes": {
            "items": {
              "$ref": "#/components/schemas/AudioProcess"
            },
            "type": "array",
            "title": "Processes"
          }
        },
        "type": "object",
        "required": [
          "available",
          "processes"
        ],
        "title": "AudioProcessesResponse"
      },
      "CascadePipelineConfig": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "cascade",
            "title": "Kind"
          },
          "asr_model": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Asr Model"
          },
          "translation_model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Translation Model"
          },
          "fallback_translation_model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Translation Model"
          },
          "tts_model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Tts Model"
          },
          "tts_voice": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Tts Voice"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "asr_model"
        ],
        "title": "CascadePipelineConfig"
      },
      "CreateSessionRequest": {
        "properties": {
          "command_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Command Id"
          },
          "owner": {
            "type": "string",
            "enum": [
              "quick_interpret",
              "browser_captions"
            ],
            "title": "Owner"
          },
          "config": {
            "$ref": "#/components/schemas/SessionConfig"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "command_id",
          "owner",
          "config"
        ],

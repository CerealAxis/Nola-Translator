{
  "schemaVersion": 1,
  "synthesis": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "number",
        "const": 1
      },
      "requestId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "modelBinding": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "voiceRef": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "engine-default"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "preset"
              },
              "modelBinding": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "voiceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "kind",
              "modelBinding",
              "voiceId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "profile"
              },
              "profileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "profileId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "session-speaker"
              },
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "speakerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "kind",
              "sessionId",
              "speakerId"
            ],
            "additionalProperties": false
          }
        ]
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64000
      },
      "targetLanguage": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "controls": {
        "type": "object",
        "properties": {
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pitch": {
            "type": "number"
          },
          "volume": {
            "type": "number",
            "minimum": 0
          },
          "emotion": {
            "type": "string",
            "maxLength": 128
          },
          "emotionStrength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "instruct": {
            "type": "string",
            "maxLength": 8000
          },
          "seed": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "wav",
              "mp3",
              "pcm"
            ]
          },
          "sampleRate": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      },
      "pronunciation": {
        "type": "object",
        "properties": {
          "dictionaryId": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "dictionaryId",
          "revision"
        ],
        "additionalProperties": false
      },
      "fallbackVoiceRef": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "engine-default"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "preset"
              },
              "modelBinding": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "voiceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "kind",
              "modelBinding",
              "voiceId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "profile"
              },
              "profileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "profileId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "session-speaker"
              },
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "speakerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "kind",
              "sessionId",
              "speakerId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "required": [
      "schemaVersion",
      "requestId",
      "modelBinding",
      "voiceRef",
      "text",
      "targetLanguage"
    ],
    "additionalProperties": false
  },
  "conditioning": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "engine-default"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "preset"
          },
          "voiceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "kind",
          "voiceId"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "reference-audio"
          },
          "assetId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "transcript": {
            "type": "string"
          },
          "recordedLanguage": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "human-reference",
              "designed-sample"
            ]
          }
        },
        "required": [
          "kind",
          "assetId",
          "sha256",
          "purpose"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "design"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "recipe": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "recipeSchema": {
            "type": "string"
          },
          "authoringModelBinding": {
            "type": "string"
          },
          "seed": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "description",
          "recipe",
          "recipeSchema",
          "authoringModelBinding"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "provider-voice"
          },
          "bindingId": {
            "type": "string"
          },
          "bindingRevision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "voiceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "scopeId": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "bindingId",
          "bindingRevision",
          "voiceId",
          "scopeId"
        ],
        "additionalProperties": false
      }
    ]
  },
  "controls": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "speed": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "pitch": {
        "type": "number"
      },
      "volume": {
        "type": "number",
        "minimum": 0
      },
      "emotion": {
        "type": "string",
        "maxLength": 128
      },
      "emotionStrength": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "instruct": {
        "type": "string",
        "maxLength": 8000
      },
      "seed": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "format": {
        "type": "string",
        "enum": [
          "wav",
          "mp3",
          "pcm"
        ]
      },
      "sampleRate": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "additionalProperties": false
  }
}

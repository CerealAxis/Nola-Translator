{
  "name": "nola-translator",
  "productName": "Nola Translator",
  "version": "1.1.0",
  "license": "GPL-3.0-only",
  "description": "Real-time Captions and Translation",
  "author": "CerealAxis",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:media": "npm --prefix docs run media",
    "build:toy": "npm --prefix docs run typecheck && node docs/scripts/build-demo.mjs --toy",
    "test:demo": "node docs/scripts/check-demo.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-python-base.ps1",
    "fetch:llama-vulkan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-llama-vulkan.ps1",
    "dist:win": "npm run fetch:llama-vulkan && npm run build && npm run build:browser && npm run package:browser && npm run build:browser-host && npm run build:python && electron-builder --win nsis msi --x64",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:ui": "electron tests/e2e/capture-ui.mjs",
    "test:layout": "electron tests/e2e/check-layout.mjs",
    "test:onboarding": "electron tests/e2e/check-onboarding.mjs",
    "test:overlay": "electron tests/e2e/capture-overlay.mjs",
    "test:packaged-ui": "node scripts/check-packaged-ui.mjs",
    "gen:notices": "node scripts/gen-third-party-notices.mjs",
    "check:notices": "node scripts/gen-third-party-notices.mjs --check",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build:browser": "node browser/extension/build.mjs && node browser/extension/build.mjs --firefox",
    "build:browser-host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-browser-host.ps1",
    "package:browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-browser-extension.ps1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@assistant-ui/ai-sdk": "^0.0.15",
    "@assistant-ui/generative-ui": "^0.0.7",
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@base-ui/react": "^1.9.0",
    "@lobehub/icons": "^5.22.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "ai": "^7.0.150",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "heat-graph": "^0.0.26",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "opencc-js": "^1.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-github-alerts": "^4.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-shimmer": "^0.4.14",
    "ws": "^8.22.0",
    "zod": "4.4.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "29.1.1",
    "tailwindcss": "^4.1.11",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "allowScripts": {
    "electron@43.1.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "build": {
    "appId": "com.nola-translator.app",
    "productName": "Nola Translator",
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release/Nola-Firefox-Extension.zip",
        "to": "browser/Nola-Firefox-Extension.zip"
      },
      {
        "from": "src/renderer/assets/fonts/OFL-Noto-CJK.txt",
        "to": "licenses/OFL-Noto-CJK.txt"
      },
      {
        "from": "engine/dist/NolaPythonEngine",
        "to": "engine"
      },
      {
        "from": "vendor/llama-vulkan",
        "to": "llama"
      },
      {
        "from": "build/runtime-catalog.json",
        "to": "runtime-catalog.json"
      },
      {
        "from": "build/runtime-recipes.json",
        "to": "runtime-recipes.json"
      },
      {
        "from": "scripts/extract-runtime.ps1",
        "to": "runtime/extract-runtime.ps1"
      },
      {
        "from": "artifacts/browser-host/NolaBrowserHost.exe",
        "to": "browser/NolaBrowserHost.exe"
      },
      {
        "from": "release/Nola-Browser-Extension.zip",
        "to": "browser/Nola-Browser-Extension.zip"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nola-Translator-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "useZip": true,
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

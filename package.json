{
  "name": "nola-translator",
  "productName": "Nola Translator",
  "version": "1.0.2",
  "license": "GPL-3.0-only",
  "description": "Real-time Captions and Translation",
  "author": "CerealAxis",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:engine:cpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-cpu-engine.ps1",
    "prepare:llama:cpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-llama-cpu.ps1",
    "dist:win": "npm run build && npm run build:browser && npm run package:browser && npm run build:browser-host && npm run build:engine:cpu && npm run prepare:llama:cpu && electron-builder --win nsis msi --x64",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:ui": "electron tests/e2e/capture-ui.mjs",
    "test:layout": "electron tests/e2e/check-layout.mjs",
    "test:overlay": "electron tests/e2e/capture-overlay.mjs",
    "test:packaged-ui": "node scripts/check-packaged-ui.mjs",
    "gen:notices": "node scripts/gen-third-party-notices.mjs",
    "check:notices": "node scripts/gen-third-party-notices.mjs --check",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build:browser": "node browser/extension/build.mjs",
    "build:browser-host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-browser-host.ps1",
    "package:browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-browser-extension.ps1"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@lobehub/icons": "^5.22.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-stately": "3.50.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "29.1.1",
    "tailwindcss": "^4.1.11",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "allowScripts": {
    "electron@43.1.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "build": {
    "appId": "com.nola-translator.app",
    "productName": "Nola Translator",
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine/dist/NolaPythonEngine",
        "to": "engine"
      },
      {
        "from": "vendor/llama-cpu",
        "to": "llama"
      },
      {
        "from": "build/runtime-catalog.json",
        "to": "runtime-catalog.json"
      },
      {
        "from": "build/runtime-recipes.json",
        "to": "runtime-recipes.json"
      },
      {
        "from": "scripts/extract-runtime.ps1",
        "to": "runtime/extract-runtime.ps1"
      },
      {
        "from": "artifacts/browser-host/NolaBrowserHost.exe",
        "to": "browser/NolaBrowserHost.exe"
      },
      {
        "from": "release/Nola-Browser-Extension.zip",
        "to": "browser/Nola-Browser-Extension.zip"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nola-Translator-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "useZip": true,
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
